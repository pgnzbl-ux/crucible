# 基础设施口令与端口（docker compose 自动读取本文件）
# 复制：cp .env.example .env
# 生产必须改掉全部默认口令；端口保持 127.0.0.1 绑定（见 docker-compose.yml）

POSTGRES_USER=crucible
POSTGRES_PASSWORD=crucible_secret
POSTGRES_DB=crucible
POSTGRES_PORT=5433

# Redis requirepass；backend/.env 的 REDIS_URL 须带同一密码：
#   redis://:crucible_redis@localhost:6380/0
REDIS_PASSWORD=crucible_redis
REDIS_PORT=6380

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
