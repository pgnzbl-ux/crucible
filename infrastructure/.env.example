# 基础设施口令与端口（docker compose 自动读取本文件）
# 复制：cp .env.example .env
# 生产必须改掉全部默认口令；端口保持 127.0.0.1 绑定（见 docker-compose.yml）

POSTGRES_USER=crucible
POSTGRES_PASSWORD=crucible_secret
POSTGRES_DB=crucible
POSTGRES_PORT=5433

# Redis requirepass；backend/.env 须带同一密码，分库：
#   REDIS_URL=redis://:crucible_redis@localhost:6380/0          # db0 事件/槽位
#   CELERY_BROKER_URL=redis://:crucible_redis@localhost:6380/1  # db1 broker
#   CELERY_RESULT_BACKEND=redis://:crucible_redis@localhost:6380/2  # db2 result
#   REDIS_CLUE_URL=redis://:crucible_redis@localhost:6380/3     # db3 合格线索+终认队
REDIS_PASSWORD=crucible_redis
REDIS_PORT=6380

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
