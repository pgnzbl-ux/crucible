# 依赖 / 虚拟环境
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/
pip-wheel-metadata/

# uv 本地解析锁（安装以 pyproject.toml + pip 为准；勿把本机 uv run 产物提交）
uv.lock

# 环境（保留示例模板）
.env
.env.*
!backend/.env.example
*.local

# 数据库 / 本地持久化
*.db
*.db-journal
*.sqlite
*.sqlite3
dump.rdb
appendonly.aof

# Python 测试 / 类型 / Lint 缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
coverage.json
htmlcov/
.hypothesis/
.tox/
.nox/
.cache/

# Node
node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.turbo/

# 前端 / E2E 产物
*.tsbuildinfo
test-results/
playwright-report/
blob-report/

# Celery
celerybeat-schedule
celerybeat.pid
*.pid

# 日志 / 备份
*.log
*.bak
*~

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo
*.suo
*.user
*.iml
.cursor/

# Claude Code 运行时（规则/skills 仍提交，锁文件不提交）
.claude/scheduled_tasks.lock

# CodeGraph 本地索引（每台机器独立）
.codegraph/

# 项目记忆 / 临时工作区
.workbuddy/
memory/
outputs/

# OS
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# Harness / 本地工具缓存
.wiscode/
.zcode/
.ipynb_checkpoints/

# docs：只纳入截图等静态资源，其余本地文档不进仓库
docs/*
!docs/assets/
!docs/discovery-spec.md
!docs/discovery-plan.md

# 黄金集评估报告（跑出来的 Markdown，不入库）
scripts/eval/out/
