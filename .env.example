# 环境变量模板 — 复制为 .env 后修改
ENVIRONMENT=development
DEBUG=true

# 数据库 — 开发用 SQLite，生产必须 PostgreSQL
# 注意：宿主机 5432 已被占用（Crucible 用 5433）
DATABASE_URL=sqlite+aiosqlite:///./crucible.db
# DATABASE_URL=postgresql+asyncpg://crucible:crucible_secret@localhost:5433/crucible

# Redis — 宿主机 6379 已被占用（Crucible 用 6380）
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# JWT 认证
AUTH_SECRET=dev-secret-change-in-production
ADMIN_EMAIL=admin@crucible.local
ADMIN_PASSWORD=crucible123

# Claude Agent SDK — Python SDK 接入第三方 Anthropic 兼容端点
# 凭据通过 docker run --env 注入 agent-runner 容器，容器销毁 env 消失（零落盘）
CLAUDE_AGENT_SDK_ENABLED=false
CLAUDE_SDK_MAX_TURNS=180

# LLM Provider（Anthropic 兼容 API — DeepSeek / 腾讯云等）
# 方案一：DeepSeek 官方（推荐）
#   https://api.deepseek.com/anthropic
#   deepseek-v4-flash(轻量) / deepseek-v4-pro(增强);两者均支持思考模式(thinking 参数切换)
# 方案二：腾讯云知识引擎
#   https://api.lkeap.cloud.tencent.com/anthropic
#   deepseek-v3.2 / deepseek-v3.1-terminus
LLM_BASE_URL=https://api.deepseek.com/anthropic
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_MS=600000
LLM_DISABLE_NONESSENTIAL_TRAFFIC=true

# Agent Runner 容器（专用镜像，worker 通过 docker SDK 拉起）
AGENT_RUNNER_IMAGE=crucible-agent-runner:base
AGENT_RUNNER_CPU_LIMIT=1.0
AGENT_RUNNER_MEMORY_LIMIT=1g
AGENT_RUNNER_NETWORK=crucible-sandbox-net
AGENT_RUNNER_WORKDIR_BASE=/tmp/crucible/audit
AGENT_RUNNER_CONCURRENCY_LIMIT=4
AGENT_RUNNER_TIMEOUT_SECONDS=1800

# 对象存储 (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=crucible-artifacts

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Sentry (可选)
SENTRY_DSN=
