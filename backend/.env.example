# 环境变量模板 — 复制为同目录 .env 后修改
ENVIRONMENT=development
DEBUG=true

# 数据库 — 开发用 SQLite，生产必须 PostgreSQL
# 注意：宿主机 5432 已被占用（Crucible 用 5433）
DATABASE_URL=sqlite+aiosqlite:///./crucible.db
# DATABASE_URL=postgresql+asyncpg://crucible:crucible_secret@localhost:5433/crucible

# Redis — 宿主机 6379 已被占用（Crucible 用 6380）
# db0 事件总线 / db1 Celery broker / db2 Celery result
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# JWT 认证
AUTH_SECRET=dev-secret-change-in-production

# Claude Agent SDK — true 启用真实 Agent；false 走 Mock
# LLM 凭据只在平台后台「设置 → LLM Provider」配置，不走环境变量
CLAUDE_AGENT_SDK_ENABLED=false
CLAUDE_SDK_MAX_TURNS=180

# Agent Runner 容器（专用镜像，worker 通过 docker SDK 拉起）
AGENT_RUNNER_IMAGE=crucible-agent-runner:base
AGENT_RUNNER_CPU_LIMIT=1.0
AGENT_RUNNER_MEMORY_LIMIT=1g
AGENT_RUNNER_NETWORK=crucible-sandbox-net
AGENT_RUNNER_WORKDIR_BASE=/tmp/crucible/audit
AGENT_RUNNER_CONCURRENCY_LIMIT=4
AGENT_RUNNER_TIMEOUT_SECONDS=1800

# 对象存储 (MinIO) — bucket 名平台写死：crucible-artifacts / crucible-evidence / crucible-source
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Sentry (可选)
SENTRY_DSN=
