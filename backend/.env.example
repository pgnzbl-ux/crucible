# 环境变量模板 — 复制为同目录 .env 后修改。
# 连接串与密钥只写在这里（config.py 无默认值）。桶名不在本文件，见 shared/object_store.py。
# LLM 凭据只在后台「设置 → LLM Provider」，不要加 LLM_* 变量。
ENVIRONMENT=development
DEBUG=true

# 数据库 — 开发/生产都连 Docker PostgreSQL（宿主机 5432 已被占用，映射 5433）
# pytest 会覆盖为 sqlite，不要把测试库写进本文件
DATABASE_URL=postgresql+asyncpg://crucible:crucible_secret@localhost:5433/crucible

# Redis — 宿主机 6379 已被占用（Crucible 用 6380）
# db0 事件总线 / db1 Celery broker / db2 Celery result
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# JWT 认证
AUTH_SECRET=dev-secret-change-in-production

# Claude Agent SDK — true 启用真实 Agent；false 走 Mock
# LLM 凭据只在平台后台「设置 → LLM Provider」配置，不走环境变量
CLAUDE_AGENT_SDK_ENABLED=false
CLAUDE_SDK_MAX_TURNS=480

# Agent Runner 容器（专用镜像，worker 通过 docker SDK 拉起）
AGENT_RUNNER_IMAGE=crucible-agent-runner:base
AGENT_RUNNER_CPU_LIMIT=1.0
AGENT_RUNNER_MEMORY_LIMIT=1g
AGENT_RUNNER_NETWORK=crucible-sandbox-net
AGENT_RUNNER_WORKDIR_BASE=/tmp/crucible/audit
# 部署级并行硬顶（1–8）：设置页四项并发预算的最大值 + Celery prefork 进程数。
# 日常调节请用「设置 → 并发与资源」，无需改 .env 或重启服务。
AGENT_RUNNER_CONCURRENCY_LIMIT=4

# 对象存储 (MinIO) — 桶名平台写死：crucible-durable / crucible-task / crucible-public
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# 扫描器：semgrep=pip + 本地社区规则仓库（无 login）
# 推荐：git clone https://github.com/semgrep/semgrep-rules.git 后指向仓库根
# SCANNER_SEMGREP_RULES_DIR=/path/to/semgrep-rules
# 未设置时 worker 会对该地址 git clone --depth 1 到 .venv/share/crucible-semgrep-rules
# 离线：二进制放进 PATH，规则树已 clone 好，并设 SCANNER_AUTO_INSTALL=false
# SCANNER_BIN_DIR=/opt/crucible/bin
# SCANNER_AUTO_INSTALL=true

# Sentry (可选)
SENTRY_DSN=
