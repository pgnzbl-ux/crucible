# 环境变量模板 — 复制为同目录 .env 后修改（勿把含真实密钥的 .env 提交进库）。
# 连接串与密钥只写在这里（config.py 无默认值）。桶名不在本文件，见 shared/object_store.py。
# LLM API Key 只在后台「设置 → LLM Provider」，不要加 LLM_API_KEY 之类变量。
#
# 生产（ENVIRONMENT=production）启动强制：
#   强 AUTH_SECRET、禁 SQLite、LLM_BASE_URL_RELAXED=false、
#   CLAUDE_AGENT_SDK_ENABLED=true、LLM_GATEWAY_ENABLED=true、
#   METRICS_TOKEN 非空、CORS_ORIGINS 精确域名（禁止 *）

ENVIRONMENT=development
DEBUG=true

# ── 基础设施连接（必填）──
# 开发/生产都连 Docker PostgreSQL（宿主机 5432 常被占用，映射 5433）
# pytest 会覆盖为 sqlite，不要把测试库写进本文件
DATABASE_URL=postgresql+asyncpg://crucible:crucible_secret@localhost:5433/crucible

# Redis — 宿主机 6379 常被占用（Crucible 用 6380）；须与 infrastructure/.env 的 REDIS_PASSWORD 一致
# db0 事件总线 / db1 Celery broker / db2 Celery result
REDIS_URL=redis://:crucible_redis@localhost:6380/0
CELERY_BROKER_URL=redis://:crucible_redis@localhost:6380/1
CELERY_RESULT_BACKEND=redis://:crucible_redis@localhost:6380/2

# 对象存储 (MinIO) — 桶名平台写死：crucible-durable / crucible-task / crucible-public
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# S3_SECURE=false

# ── JWT / SSE / Metrics ──
# 生产必须强随机，禁止沿用本示例值
AUTH_SECRET=dev-secret-change-in-production
# 访问令牌有效期（分钟）；代码默认 60。本地开发可加长
AUTH_TOKEN_EXPIRE_MINUTES=60
# SSE 短命 ticket（秒）；前端 EventSource 用 ?ticket=，勿把长 JWT 塞进 URL
SSE_TICKET_EXPIRE_SECONDS=120
# Prometheus /metrics：开发可留空（开放）；生产必须非空，请求带 Authorization: Bearer <token>
METRICS_TOKEN=

# ── Agent / LLM 开关 ──
# true=真实 Agent；false=Mock。生产启动强制 true
CLAUDE_AGENT_SDK_ENABLED=false
CLAUDE_SDK_MAX_TURNS=480
# 轻量二审 Messages 网关；false=固定 mock 判决。生产强制 true
LLM_GATEWAY_ENABLED=true
# Provider Base URL：生产必须 false。本地开发可 true（指本机/私网网关）
# false=仅 HTTPS 公网域名；true=暂不限制 http/IP/本机私网
LLM_BASE_URL_RELAXED=true

# ── Agent Runner（.env 会经 Settings 注入容器规格）──
AGENT_RUNNER_IMAGE=crucible-agent-runner:base
AGENT_RUNNER_CPU_LIMIT=1.0
AGENT_RUNNER_MEMORY_LIMIT=1g
AGENT_RUNNER_NETWORK=crucible-sandbox-net
# 工作区路径前缀（不是共享目录）：任务 → {BASE}-{task_id}；Lab → {BASE}/labs/{lab_id}
# 例：/tmp/crucible/audit-<uuid> 、 /tmp/crucible/audit/labs/<lab_id>
AGENT_RUNNER_WORKDIR_BASE=/tmp/crucible/audit
# 部署级并行硬顶（1–8）：设置页并发预算上限 + Celery prefork 进程数
AGENT_RUNNER_CONCURRENCY_LIMIT=4

# ── CORS（生产须为精确域名，禁止 *）──
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# ── 扫描器（可选）──
# 推荐：git clone https://github.com/semgrep/semgrep-rules.git 后指向仓库根
# SCANNER_SEMGREP_RULES_DIR=/path/to/semgrep-rules
# 未设置时 worker 会 git clone --depth 1 到 .venv/share/crucible-semgrep-rules
# SCANNER_BIN_DIR=/opt/crucible/bin
# SCANNER_AUTO_INSTALL=true

# ── 其它可选 ──
# SETTINGS_ENCRYPT_KEY=   # Fernet 目前未接入，配置无效；Key 仍明文落库
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
